<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <RootNamespace>IczpNet.AppUpdater</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <Version>0.1.0</Version>
    <Authors>IczpNet</Authors>
    <RepositoryUrl>https://github.com/Iczp/app-updater.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/iczp/app-updater.git</PackageProjectUrl>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Copyright>(c) iczp.net</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Chat module for abp</Description>
    <PackageIcon>IczpNet.jpg</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IczpNet.AbpCommons.Domain.Shared" Version="0.10.0" />
    <PackageReference Include="IczpNet.AbpCommons.Host.Shared" Version="0.10.0" />
    <PackageReference Include="Volo.Abp.Ddd.Domain.Shared" Version="10.6.1" />
    <PackageReference Include="Volo.Abp.Validation" Version="10.6.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\AppUpdater\*.json" />
    <Content Remove="Localization\AppUpdater\*.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\IczpNet.jpg" Link="IczpNet.jpg">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
    <None Include="..\..\README.md" Link="README.md">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="ConfigureAwait.Fody" Version="3.4.1" />
    <PackageReference Update="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
